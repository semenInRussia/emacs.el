$0int getmax(int l, int r) {
  l += SZ;
  r += SZ;
  int ans = 0;
  while (l < r) {
    if (l & 1) {
      ans = max(ans, t[l++]);
    }
    if (r & 1) {
      ans = max(ans, t[--r]);
    }
    l >>= 1;
    r >>= 1;
  }
  return ans;
}

void upd(int j, int v) {
  int x = SZ + j;
  t[x] = v;
  while (x > 0) {
    x >>= 1;
    t[x] = max(t[2 * x], t[2 * x + 1]);
  }
}
